\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Integrated results by model, interaction frame, conversation structure, and rubric dimension. Values aggregate the two LLM judges, Qwen2.5-7B-Instruct and Gemma-4-E4B-it: numeric fields are averaged across valid judges, and harmful elaboration is flagged if either judge marks it present. Rubric columns aggregate over all 24 scenarios for a model-frame pair. Harm values are percentages. Structure cells report overall score and harmful-elaboration rate.}}{6}{table.caption.3}\protected@file@percent }
\newlabel{tab:integrated_results}{{2}{6}{Integrated results by model, interaction frame, conversation structure, and rubric dimension. Values aggregate the two LLM judges, Qwen2.5-7B-Instruct and Gemma-4-E4B-it: numeric fields are averaged across valid judges, and harmful elaboration is flagged if either judge marks it present. Rubric columns aggregate over all 24 scenarios for a model-frame pair. Harm values are percentages. Structure cells report overall score and harmful-elaboration rate}{table.caption.3}{}}
