{
  "models": [
    {
      "provider": "huggingface",
      "model": "meta-llama/Llama-3.2-1B-Instruct",
      "config_path": "configs/models/llama32_1b_instruct.yaml"
    },
    {
      "provider": "huggingface",
      "model": "meta-llama/Llama-3.2-3B-Instruct",
      "config_path": "configs/models/llama32_3b_instruct.yaml"
    },
    {
      "provider": "huggingface",
      "model": "meta-llama/Llama-3.1-8B-Instruct",
      "config_path": "configs/models/llama31_8b_instruct.yaml"
    },
    {
      "provider": "huggingface",
      "model": "Qwen/Qwen2.5-0.5B-Instruct",
      "config_path": "configs/models/qwen25_0_5b_instruct.yaml"
    },
    {
      "provider": "huggingface",
      "model": "Qwen/Qwen2.5-1.5B-Instruct",
      "config_path": "configs/models/qwen25_1_5b_instruct.yaml"
    },
    {
      "provider": "huggingface",
      "model": "Qwen/Qwen2.5-3B-Instruct",
      "config_path": "configs/models/qwen25_3b_instruct.yaml"
    },
    {
      "provider": "huggingface",
      "model": "Qwen/Qwen2.5-7B-Instruct",
      "config_path": "configs/models/qwen25_7b_instruct.yaml"
    },
    {
      "provider": "huggingface",
      "model": "Qwen/Qwen2.5-14B-Instruct",
      "config_path": "configs/models/qwen25_14b_instruct_4bit.yaml"
    },
    {
      "provider": "huggingface",
      "model": "google/gemma-3-1b-it",
      "config_path": "configs/models/gemma3_1b_it.yaml"
    },
    {
      "provider": "huggingface",
      "model": "google/gemma-3-4b-it",
      "config_path": "configs/models/gemma3_4b_it.yaml"
    },
    {
      "provider": "huggingface",
      "model": "google/gemma-3-12b-it",
      "config_path": "configs/models/gemma3_12b_it_4bit.yaml"
    },
    {
      "provider": "huggingface",
      "model": "google/gemma-4-E2B-it",
      "config_path": "configs/models/gemma4_e2b_it.yaml"
    },
    {
      "provider": "huggingface",
      "model": "google/gemma-4-E4B-it",
      "config_path": "configs/models/gemma4_e4b_it.yaml"
    }
  ],
  "api_keys": {
    "gemini": "env:GEMINI_API_KEY",
    "openai": "env:OPENAI_API_KEY",
    "anthropic": "env:ANTHROPIC_API_KEY"
  },
  "huggingface": {
    "device_map": "auto",
    "dtype": "bfloat16",
    "load_in_8bit": false,
    "load_in_4bit": false,
    "trust_remote_code": true,
    "low_cpu_mem_usage": true,
    "max_seq_length": 4096,
    "use_chat_template": true,
    "max_new_tokens": 1800,
    "temperature": 0.7,
    "do_sample": true,
    "top_p": 0.95
  },
  "judges": [
    {
      "provider": "huggingface",
      "model": "Qwen/Qwen2.5-7B-Instruct",
      "config_path": "configs/models/qwen25_7b_instruct.yaml",
      "temperature": 0.1,
      "max_tokens": 4000,
      "generation": {
        "do_sample": false
      }
    },
    {
      "provider": "huggingface",
      "model": "google/gemma-4-E4B-it",
      "config_path": "configs/models/gemma4_e4b_it.yaml",
      "temperature": 0.1,
      "max_tokens": 4000,
      "generation": {
        "do_sample": false
      }
    }
  ],
  "evaluation": {
    "max_retries": 2,
    "delay_between_requests": 0.5,
    "retry_delay": 1.0,
    "timeout": 300,
    "parallel_scenarios": 1,
    "save_intermediate_results": true,
    "save_intermediate_every": 1,
    "unload_target_before_judge": true,
    "unload_after_judge": true,
    "unload_after_model": true
  },
  "output": {
    "detailed_logs": true,
    "save_conversations": true,
    "results_directory": "./results/",
    "include_raw_responses": true
  }
}
